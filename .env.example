# --- Google Cloud Console → APIs & Services → Credentials ---
# All three are public by design: they ship inside the JavaScript bundle.
# The API key is safe only because of its restrictions (see README).

# OAuth client ID (Web application). The browser flow uses no client secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API key, used by the Google Picker as its developer key.
# Restrict it to the Picker API + Drive API, and if you restrict by website you
# MUST allow https://docs.google.com/* as well — the Picker renders in an
# iframe on that domain, and omitting it fails with "API developer key is invalid".
NEXT_PUBLIC_GOOGLE_API_KEY=

# Cloud project NUMBER (not the project ID, not the client ID).
# Console home dashboard → Project number. Used as the Picker's app ID; without
# it the folder you pick won't be granted to this app and Drive calls will 404.
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# Only needed when serving under a subpath (GitHub Pages project site).
# Leave unset for local dev; CI sets it to /expense-tracker.
# NEXT_PUBLIC_BASE_PATH=/expense-tracker
